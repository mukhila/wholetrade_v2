<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8fafc">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ── 1. LOGIN CONTAINER ── -->
        <LinearLayout
            android:id="@+id/layoutLogin"
            android:orientation="vertical"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Server Connection"
                android:textStyle="bold"
                android:textColor="#1e293b"
                android:textSize="18sp"
                android:layout_marginBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Connect the print service to your WholeTrade server."
                android:textColor="#64748b"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/etServer"
                android:hint="https://sgtrade.techgeeksdigi.com"
                android:inputType="textUri"
                android:padding="12dp"
                android:background="@android:drawable/editbox_background_normal"
                android:layout_marginBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/etCompanyCode"
                android:hint="Company Code"
                android:inputType="textVisiblePassword"
                android:padding="12dp"
                android:background="@android:drawable/editbox_background_normal"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnLogin"
                android:text="Connect &amp; Login"
                android:textColor="#ffffff"
                android:backgroundTint="#0f766e"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvLoginStatus"
                android:text="Not logged in"
                android:textColor="#dc2626"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- ── 2. DASHBOARD CONTAINER ── -->
        <LinearLayout
            android:id="@+id/layoutDashboard"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Welcome Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Connected Server"
                        android:textStyle="bold"
                        android:textColor="#1e293b"
                        android:textSize="18sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvDashboardCompanyName"
                        android:text="WholeTrade Business"
                        android:textColor="#0f766e"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnLogout"
                    android:text="Logout"
                    android:textSize="12sp"
                    android:textColor="#ffffff"
                    android:backgroundTint="#dc2626"
                    android:layout_alignParentEnd="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </RelativeLayout>

            <!-- Bluetooth Printer Pairing Section -->
            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="1 · Bluetooth Printer Pairing"
                    android:textStyle="bold"
                    android:textColor="#1e293b"
                    android:textSize="15sp"
                    android:layout_marginBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Select the paired Bluetooth printer to print invoices."
                    android:textColor="#64748b"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnPickPrinter"
                    android:text="Connect Printer Pairing"
                    android:backgroundTint="#2563eb"
                    android:textColor="#ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvPrinter"
                    android:text="No printer selected (Gallery fallback active)"
                    android:textColor="#475569"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Print Service Section -->
            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="2 · Print Service Background Polling"
                    android:textStyle="bold"
                    android:textColor="#1e293b"
                    android:textSize="15sp"
                    android:layout_marginBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="What is this? Running this service allows the app to fetch print jobs from your server in the background and automatically open the print preview window."
                    android:textColor="#64748b"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnService"
                    android:text="Start Print Service"
                    android:backgroundTint="#0d9488"
                    android:textColor="#ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvServiceStatus"
                    android:text="Service stopped"
                    android:textColor="#e11d48"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Settings & Tools Section -->
            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="3 · Settings &amp; Diagnostics"
                    android:textStyle="bold"
                    android:textColor="#1e293b"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <CheckBox
                    android:id="@+id/cbAutoCut"
                    android:text="Enable automatic paper cutting"
                    android:textColor="#334155"
                    android:layout_marginBottom="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnTestPrint"
                    android:text="Test Print Receipt"
                    android:backgroundTint="#475569"
                    android:textColor="#ffffff"
                    android:layout_marginBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnOpenGallery"
                    android:text="Open Saved Receipts Gallery"
                    android:backgroundTint="#64748b"
                    android:textColor="#ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Log Console -->
            <TextView
                android:text="Activity Log Console"
                android:textSize="11sp"
                android:textColor="#94a3b8"
                android:layout_marginBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvLog"
                android:textSize="11sp"
                android:textColor="#cbd5e1"
                android:background="#1e293b"
                android:padding="10dp"
                android:typeface="monospace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
